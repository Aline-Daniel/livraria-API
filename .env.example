# Exemplo de variáveis de ambiente (não coloque uma senha real no GitHub).
# Este arquivo é referência; configure as variáveis no sistema operacional.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livraria
DB_USER=usuario_local
DB_PASSWORD=substitua_por_sua_senha
PORT=3000
# Gere uma chave privada de 32 bytes (64 dígitos hex). Nunca commit a chave real.
# Use npm run setup:local para gerar automaticamente um .env.local ignorado pelo Git.
API_WRITE_KEY=COLOQUE_AQUI_64_CARACTERES_HEXADECIMAIS
